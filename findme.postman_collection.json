{
  "info": {
    "_postman_id": "a5e8f4c2-9b3d-4e12-8f90-7d6c5b4a3e21",
    "name": "FindMe API - Auth Service",
    "description": "Collection Postman officielle pour la recette et le test direct de l'application Spring Boot FindMe Auth Service.\n\nContient tous les endpoints d'authentification (avec vérification OTP par mail, réinitialisation par OTP et déconnexion par Refresh Token) avec leurs en-têtes, corps de requête JSON et scripts automatiques de sauvegarde des tokens JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentification",
      "description": "Gestion de l'inscription, vérification OTP, connexion, rafraîchissement des tokens, déconnexion et réinitialisation de mot de passe.",
      "item": [
        {
          "name": "Inscription (SignUp)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"Password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Création d'un nouveau compte utilisateur non vérifié et envoi d'un code OTP à 6 chiffres par email.\n- Mot de passe obligatoire: min 8 caractères, au moins 1 majuscule et 1 chiffre.\n- Statut de retour attendu: 201 Created"
          },
          "response": []
        },
        {
          "name": "Vérification de compte (Verify Account OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"code\": \"{{otp_code}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/verify-account",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-account"
              ]
            },
            "description": "Vérifie et active le compte utilisateur à l'aide du code OTP à 6 chiffres reçu par mail.\n- Statut de retour attendu: 200 OK"
          },
          "response": []
        },
        {
          "name": "Renvoi OTP (Resend OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/resend-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-otp"
              ]
            },
            "description": "Génère et renvoie un nouveau code OTP de vérification par mail pour un compte non encore vérifié."
          },
          "response": []
        },
        {
          "name": "Connexion (SignIn)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.collectionVariables.set('access_token', jsonData.accessToken);",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/signin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signin"
              ]
            },
            "description": "Authentification de l'utilisateur (le compte doit être vérifié préalable par OTP).\nSauvegarde automatiquement `access_token` et `refresh_token` dans les variables de collection Postman."
          },
          "response": []
        },
        {
          "name": "Rafraîchissement des tokens (Refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.collectionVariables.set('access_token', jsonData.accessToken);",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Génère un nouvel Access Token et effectue la rotation du Refresh Token."
          },
          "response": []
        },
        {
          "name": "Déconnexion (Logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Révoque le Refresh Token transmis dans le corps de la requête.\nEndpoint public : ne nécessite pas d'en-tête Authorization valide si le token est dans le corps.\nStatut de retour attendu: 204 No Content"
          },
          "response": []
        },
        {
          "name": "Mot de passe oublié (Forgot Password OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Génère et envoie un code OTP de réinitialisation par email.\nRetourne 200 OK systématiquement (anti- account enumeration)."
          },
          "response": []
        },
        {
          "name": "Réinitialiser mot de passe (Reset Password OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"code\": \"{{otp_code}}\",\n  \"newPassword\": \"NewPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "reset-password"
              ]
            },
            "description": "Réinitialise le mot de passe grâce à l'email, au code OTP à 6 chiffres reçu par mail et au nouveau mot de passe. Révoque tous les refresh tokens existants de l'utilisateur."
          },
          "response": []
        },
        {
          "name": "Connexion Google (Redirection Web)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/google/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "google",
                "login"
              ]
            },
            "description": "Redirige le navigateur vers la mire d'authentification Google OAuth2."
          },
          "response": []
        },
        {
          "name": "Connexion Google (ID Token Mobile / SPA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"eyJhbGciOiJSUzI1NiIs...\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "google"
              ]
            },
            "description": "Authentifie l'utilisateur via son ID Token Google émis par le SDK mobile ou SPA."
          },
          "response": []
        },
        {
          "name": "Connexion Apple (Redirection Web)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/apple/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "apple",
                "login"
              ]
            },
            "description": "Redirige le navigateur vers la mire d'authentification Sign in with Apple."
          },
          "response": []
        },
        {
          "name": "Connexion Apple (ID Token Mobile / SPA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"eyJhbGciOiJSUzI1NiIs...\",\n  \"firstName\": \"Jean\",\n  \"lastName\": \"Dupont\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/apple",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "apple"
              ]
            },
            "description": "Authentifie l'utilisateur via son ID Token Apple émis par le SDK mobile Sign in with Apple."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Profil Utilisateur",
      "description": "Endpoints de consultation et mise à jour du profil (Nécessite le Bearer Token).",
      "item": [
        {
          "name": "Obtenir le profil courant (Get Profile)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Récupère les informations de l'utilisateur actuellement connecté."
          },
          "response": []
        },
        {
          "name": "Mettre à jour le profil (Update Profile)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phoneNumber\": \"+33612345678\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Met à jour le prénom, le nom et le numéro de téléphone (optionnel) de l'utilisateur connecté."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Monitoring & Documentation",
      "description": "Endpoints d'état de santé et de documentation API.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/actuator/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Vérifie l'état de l'application et de ses dépendances (base de données)."
          },
          "response": []
        },
        {
          "name": "OpenAPI Docs JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api-docs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api-docs"
              ]
            },
            "description": "Récupère les spécifications OpenAPI (Swagger) au format JSON."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "user_email",
      "value": "user@example.com",
      "type": "string"
    },
    {
      "key": "otp_code",
      "value": "123456",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ]
}