    {
      "name": "2. Profil Utilisateur",
      "description": "Endpoints de consultation et mise à jour du profil (Nécessite le Bearer Token).",
      "item": [
        {
          "name": "Obtenir le profil courant (Get Profile)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Récupère les informations de l'utilisateur actuellement connecté."
          },
          "response": []
        },
        {
          "name": "Mettre à jour le profil (Update Profile)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"phoneNumber\": \"+33612345678\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Met à jour le prénom, le nom et le numéro de téléphone (optionnel) de l'utilisateur connecté."
          },
          "response": []
        },
        {
          "name": "Upload Image de Profil (Upload Profile Image)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/users/me/profile-image",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "me",
                "profile-image"
              ]
            },
            "description": "Téléverse ou remplace l'image de profil de l'utilisateur connecté.\nFormats acceptés : JPEG, PNG, WEBP. Taille maximale : 5 Mo."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Addresses",
      "description": "Endpoints de gestion des adresses de l'utilisateur (CRUD, photo, export PDF). Nécessite le Bearer Token.",
      "item": [
        {
          "name": "Lister les adresses (List Addresses)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/addresses?page=0&size=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "addresses"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Retourne la liste paginée, triée et filtrable des adresses de l'utilisateur connecté"
          }
        },
        {
          "name": "Créer une adresse (Create Address)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country\": \"Cameroun\",\n  \"city\": \"Douala\",\n  \"district\": \"Bonanjo\",\n  \"postalCode\": \"BP123\",\n  \"street\": \"Avenue de la Liberté\",\n  \"houseNumber\": \"10\",\n  \"gps\": {\n    \"latitude\": 4.0511,\n    \"longitude\": 9.7679\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/addresses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "addresses"
              ]
            },
            "description": "Crée une nouvelle adresse et la rattache à l'utilisateur (blocage strict à 4 adresses max). Les champs obligatoires sont : country, city, district, street et gps. Le postalCode est optionnel."
          }
        },
        {
          "name": "Détail d'une adresse (Get Address By ID)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/addresses/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "addresses",
                "1"
              ]
            },
            "description": "Retourne les détails d'une adresse spécifique si elle appartient à l'utilisateur"
          }
        },
        {
          "name": "Modifier une adresse (Update Address)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country\": \"Cameroun\",\n  \"city\": \"Douala\",\n  \"district\": \"Akwa\",\n  \"postalCode\": \"BP456\",\n  \"street\": \"Rue de la Joie\",\n  \"houseNumber\": \"20\",\n  \"gps\": {\n    \"latitude\": 4.0511,\n    \"longitude\": 9.7500\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/addresses/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "addresses",
                "1"
              ]
            },
            "description": "Met à jour les informations d'une adresse appartenant à l'utilisateur. Attention : avec l'unification des modèles de requête (AddressRequestDTO), les champs obligatoires (country, city, gps) doivent désormais être systématiquement fournis même pour une modification."
          }
        },
        {
          "name": "Supprimer une adresse (Delete Address)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/addresses/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "addresses",
                "1"
              ]
            },
            "description": "Supprime le lien d'adresse pour l'utilisateur (et l'adresse si elle devient orpheline)"
          }
        },
        {
          "name": "Upload de photo d'adresse (Upload Photo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.photoUrl) {",
                  "        var parts = jsonData.photoUrl.split('/');",
                  "        var filename = parts[parts.length - 1];",
                  "        pm.collectionVariables.set('uploaded_filename', filename);",
                  "        console.log('Nom de fichier sauvegardé dans uploaded_filename:', filename);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": "sample_image.png"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/addresses/1/photo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "addresses",
                "1",
                "photo"
              ]
            },
            "description": "Téléverse ou remplace l'image associée à une adresse (JPEG, PNG, WEBP, max 5 Mo). Sélectionner le fichier 'sample_image.png' inclus à la racine du projet FindMe."
          },
          "response": []
        },
        {
          "name": "Exportation PDF data (Export Address Pdf Data)",
          "request": {
            "method": "GET",
