{
  "info": {
    "_postman_id": "a5e8f4c2-9b3d-4e12-8f90-7d6c5b4a3e21",
    "name": "FindMe API - Auth Service",
    "description": "Collection Postman officielle pour la recette et le test direct de l'application Spring Boot FindMe Auth Service.\n\nContient tous les endpoints de l'application avec leurs en-têtes, corps de requête JSON et scripts automatiques de sauvegarde des tokens JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentification",
      "description": "Gestion de l'inscription, la connexion, le rafraîchissement des tokens et le mot de passe.",
      "item": [
        {
          "name": "Inscription (SignUp)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Création d'un nouveau compte utilisateur.\n- Mot de passe obligatoire: min 8 caractères, au moins 1 majuscule et 1 chiffre.\n- Statut de retour attendu: 201 Created"
          },
          "response": []
        },
        {
          "name": "Connexion (SignIn)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.collectionVariables.set('access_token', jsonData.accessToken);",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/signin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signin"
              ]
            },
            "description": "Authentification de l'utilisateur.\nSauvegarde automatiquement `access_token` et `refresh_token` dans les variables de collection Postman lors du succès (HTTP 200)."
          },
          "response": []
        },
        {
          "name": "Rafraîchissement des tokens (Refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.collectionVariables.set('access_token', jsonData.accessToken);",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Génère un nouvel Access Token et effectue la rotation du Refresh Token."
          },
          "response": []
        },
        {
          "name": "Déconnexion (Logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Révoque tous les Refresh Tokens de l'utilisateur connecté.\nNécessite d'être authentifié (Token Bearer).\nStatut de retour attendu: 204 No Content"
          },
          "response": []
        },
        {
          "name": "Mot de passe oublié (Forgot Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Demande de réinitialisation de mot de passe.\nRetourne 200 OK systématiquement pour des raisons de sécurité."
          },
          "response": []
        },
        {
          "name": "Réinitialiser mot de passe (Reset Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"token_reinitialisation_fourni\",\n  \"newPassword\": \"NewPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "reset-password"
              ]
            },
            "description": "Définition d'un nouveau mot de passe grâce à un token de réinitialisation valide."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Profil Utilisateur",
      "description": "Endpoints de consultation et mise à jour du profil (Nécessite le Bearer Token).",
      "item": [
        {
          "name": "Obtenir le profil courant (Get Profile)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Récupère les informations de l'utilisateur actuellement connecté."
          },
          "response": []
        },
        {
          "name": "Mettre à jour le profil (Update Profile)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Met à jour le prénom et le nom de l'utilisateur connecté."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Monitoring & Documentation",
      "description": "Endpoints d'état de santé et de documentation API.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/actuator/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Vérifie l'état de l'application et de ses dépendances (base de données)."
          },
          "response": []
        },
        {
          "name": "OpenAPI Docs JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api-docs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api-docs"
              ]
            },
            "description": "Récupère les spécifications OpenAPI (Swagger) au format JSON."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ]
}