# =============================================================================
# FindMe - Modèle de variables d'environnement (.env.example)
#
# INSTRUCTIONS :
# 1. Ne mettez JAMAIS de vrais secrets dans ce fichier (il est versionné sur Git).
# 2. Copiez ce fichier vers .env : `cp .env.example .env`
# 3. Remplacez les valeurs ci-dessous par vos vrais identifiants dans .env.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Base de données PostgreSQL
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/findme_db
DB_USER=findme_user
DB_PASSWORD=your_db_password_here
POSTGRES_DB=findme_db

# -----------------------------------------------------------------------------
# 2. Sécurité & Authentification JWT (HMAC-SHA256 - 256 bits minimum)
# -----------------------------------------------------------------------------
JWT_SECRET=your_base64_secret_key_minimum_256_bits_here
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# -----------------------------------------------------------------------------
# 3. Serveur & Réseau (CORS, URLs)
# -----------------------------------------------------------------------------
SERVER_PORT=8080
BACKEND_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# 4. Google OAuth2 (Console Google Cloud)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PROJECT_ID=your-google-project-id

# -----------------------------------------------------------------------------
# 5. Apple Sign-In OAuth2 (Apple Developer Console)
# -----------------------------------------------------------------------------
APPLE_TEAM_ID=your-apple-team-id
APPLE_CLIENT_ID=com.geolink.findme.client
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./src/main/resources/apple-private-key.p8
APPLE_CLIENT_SECRET=your-apple-client-secret

# -----------------------------------------------------------------------------
# 6. Envoi d'emails & OTP
# -----------------------------------------------------------------------------
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
APP_MAIL_FROM="findMe <no-reply@findme.geolink.com>"
APP_OTP_TTL_MINUTES=10

# -----------------------------------------------------------------------------
# 7. Stockage des fichiers locaux
# -----------------------------------------------------------------------------
STORAGE_LOCATION=uploads
